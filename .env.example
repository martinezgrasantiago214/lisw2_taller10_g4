# Copie este archivo como .env para cambiar los valores por defecto de docker-compose.yml.
# Los valores de ejemplo sirven para desarrollo; en produccion cambielos todos.

# Consola de administracion de Keycloak (http://localhost:8180/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Base de datos de Keycloak (PostgreSQL)
KEYCLOAK_DB_PASSWORD=keycloak

# Secreto del cliente confidencial saberpro-backend (debe coincidir con el de keycloak/realm-saberpro.json
# o con el que se regenere en la consola de Keycloak: Clients > saberpro-backend > Credentials).
SERVICE_CLIENT_SECRET=saberpro-backend-secret

# Usuario de RabbitMQ (consola en http://localhost:15672)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
